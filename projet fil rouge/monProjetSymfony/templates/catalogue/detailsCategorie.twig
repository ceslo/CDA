{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
	{% for art in articles %}
		<a href="/catalogue/article/{{art.id}}" class="card">
			<img src="../img/{{art.img_article}}" alt="">
			<div class="card-img-overlay">
				<h5 class="text-center">{{art.libelleArticle}}</h5>
			</div>
		</a>
	{% endfor %}

	{% for cat in categories %}
		<a href="/catalogue/categorie/{{cat.id}}" class="card">
			<img src="../img/{{cat.img_categorie}}" alt="">
			<div class="card-img-overlay">
				<h5 class="text-center">{{cat.libelleCategorie}}</h5>
			</div>
		</a>
	{% endfor %}

{% endblock %}
