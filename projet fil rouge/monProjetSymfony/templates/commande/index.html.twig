{% extends 'base.html.twig' %}

{% block title %}Votre commande
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item active" aria-current="page">
					<a class="link" href="#">Recapitulatif de la commande</a>
				</li>
				<li class="breadcrumb-item">Livraison</li>
				<li class="breadcrumb-item">Mode de paiement</li>
			</ol>
		</nav>
		{% for item in panier %}
			<div class="row">
				<h5 class="col sousTitre">{{item.article.libelleArticle}}</h5>
				<p class="col sousTitre">
					{{item.article.prixAchat}}€ x
					{{item.quantite}}
					=
					{{item.article.prixAchat*item.quantite}}
					€
				</p>
			</div>
		{% endfor %}
		<div>
        <p>Choisir une adresse de livraison</p>
        <p>
        </p>
        </div>
	</div>
{% endblock %}
